---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Baker's Percentage & Sourdough Hydration Calculator",
  description =
    "Free online baker's percentage and sourdough hydration calculator. Convert recipe weights to baker's percentages, scale formulas by flour or total dough weight, and calculate true dough hydration with starter.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {
          stored = null;
        }
        var prefersDark =
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (stored === "dark" || (stored === null && prefersDark)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body
    class="flex min-h-screen flex-col bg-stone-100 text-stone-900 antialiased dark:bg-stone-950 dark:text-stone-100"
  >
    <slot />
  </body>
</html>
