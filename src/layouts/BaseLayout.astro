---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Baker's Percentage & Sourdough Hydration Calculator",
  description =
    "Free online baker's percentage and sourdough hydration calculator. Convert recipe weights to baker's percentages, scale formulas by flour or total dough weight, and calculate true dough hydration with starter.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-stone-100 text-stone-900 antialiased">
    <slot />
  </body>
</html>
